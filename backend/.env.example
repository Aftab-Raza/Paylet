# Host development (Vite on 5173). Docker uses the root .env instead.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=
DATABASE_URL=postgresql://paylet:replace_with_database_password@localhost:5432/paylet?schema=public
SESSION_SECRET=replace_with_random_hex_session_secret_at_least_32_characters
GOOGLE_CLIENT_ID=local-disabled
GOOGLE_CLIENT_SECRET=local-disabled
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
