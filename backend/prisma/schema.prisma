generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique @db.VarChar(254)
  username           String                   @unique @db.VarChar(30)
  displayName        String                   @db.VarChar(100)
  passwordHash       String?
  googleId           String?                  @unique
  avatarUrl          String?
  bio                String?                  @db.VarChar(250)
  defaultCurrency    String                   @default("INR") @db.VarChar(3)
  timezone           String                   @default("Asia/Kolkata") @db.VarChar(100)
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  expenses           Expense[]
  contacts           Contact[]
  ownedGroups        SplitGroup[]
  groupMemberships   SplitMember[]
  groupInvitations   SplitInvitation[]
  recordedBills      SharedBill[]
  billActions        SharedBillHistory[]
  createdSettlements GroupSettlement[]
  settlementActions  GroupSettlementHistory[]

  @@map("users")
}

model Expense {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountMinor BigInt
  currency    String            @db.VarChar(3)
  minorUnit   Int
  purpose     String            @db.VarChar(200)
  category    String            @db.VarChar(40)
  spentOn     DateTime          @db.Date
  version     Int               @default(1)
  voidedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  revisions   ExpenseRevision[]

  @@index([userId, spentOn])
  @@map("expenses")
}

model ExpenseRevision {
  id        String   @id @default(uuid()) @db.Uuid
  expenseId String   @db.Uuid
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  action    String   @db.VarChar(20)
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([expenseId, createdAt])
  @@map("expense_revisions")
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String   @db.VarChar(100)
  nickname   String?  @db.VarChar(100)
  notes      String?  @db.VarChar(500)
  isArchived Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  loans        Loan[]
  moneyEntries ContactMoneyEntry[]

  @@index([userId, isArchived, name])
  @@map("contacts")
}

model Loan {
  id          String    @id @default(uuid()) @db.Uuid
  contactId   String    @db.Uuid
  direction   String    @db.VarChar(10)
  amountMinor BigInt
  currency    String    @db.VarChar(3)
  minorUnit   Int
  purpose     String    @db.VarChar(200)
  loanDate    DateTime  @db.Date
  dueDate     DateTime? @db.Date
  version     Int       @default(1)
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  repayments LoanRepayment[]
  history    LoanHistory[]

  @@index([contactId, loanDate])
  @@map("loans")
}

model LoanRepayment {
  id          String    @id @default(uuid()) @db.Uuid
  loanId      String    @db.Uuid
  amountMinor BigInt
  paidOn      DateTime  @db.Date
  note        String?   @db.VarChar(300)
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@index([loanId, paidOn])
  @@map("loan_repayments")
}

model LoanHistory {
  id        String   @id @default(uuid()) @db.Uuid
  loanId    String   @db.Uuid
  action    String   @db.VarChar(30)
  snapshot  Json
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@index([loanId, createdAt])
  @@map("loan_history")
}

model ContactMoneyEntry {
  id           String    @id @default(uuid()) @db.Uuid
  contactId    String    @db.Uuid
  direction    String    @db.VarChar(10)
  kind         String    @db.VarChar(10)
  amountMinor  BigInt
  currency     String    @db.VarChar(3)
  minorUnit    Int
  purpose      String    @db.VarChar(300)
  entryDate    DateTime  @db.Date
  voidedAt     DateTime?
  legacyLoanId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contact Contact               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  history ContactMoneyHistory[]

  @@index([contactId, entryDate])
  @@map("contact_money_entries")
}

model ContactMoneyHistory {
  id        String   @id @default(uuid()) @db.Uuid
  entryId   String   @db.Uuid
  action    String   @db.VarChar(30)
  snapshot  Json
  createdAt DateTime @default(now())

  entry ContactMoneyEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@map("contact_money_history")
}

model SplitGroup {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @db.Uuid
  name      String    @db.VarChar(80)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members     SplitMember[]
  invitations SplitInvitation[]
  bills       SharedBill[]
  settlements GroupSettlement[]

  @@index([ownerId, createdAt])
  @@map("split_groups")
}

model SplitMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  group SplitGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  paidBills           SharedBill[]
  shares              SharedBillShare[]
  sentSettlements     GroupSettlement[] @relation("SettlementSender")
  receivedSettlements GroupSettlement[] @relation("SettlementRecipient")
  reversalRequests    GroupSettlement[] @relation("ReversalRequester")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("split_members")
}

model SplitInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  recipientId String    @db.Uuid
  status      String    @default("PENDING") @db.VarChar(12)
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  group     SplitGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  recipient User       @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([groupId, recipientId])
  @@index([recipientId, status])
  @@map("split_invitations")
}

model SharedBill {
  id          String              @id @default(uuid()) @db.Uuid
  groupId     String              @db.Uuid
  creatorId   String              @db.Uuid
  payerId     String              @db.Uuid
  amountMinor BigInt
  currency    String              @db.VarChar(3)
  minorUnit   Int
  purpose     String              @db.VarChar(200)
  category    String              @db.VarChar(40)
  spentOn     DateTime            @db.Date
  splitMode   String              @db.VarChar(10)
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  group       SplitGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  creator     User                @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  payer       SplitMember         @relation(fields: [payerId], references: [id], onDelete: Restrict)
  shares      SharedBillShare[]
  history     SharedBillHistory[]

  @@index([groupId, spentOn])
  @@map("shared_bills")
}

model SharedBillShare {
  id          String      @id @default(uuid()) @db.Uuid
  billId      String      @db.Uuid
  memberId    String      @db.Uuid
  amountMinor BigInt
  bill        SharedBill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  member      SplitMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([billId, memberId])
  @@index([memberId])
  @@map("shared_bill_shares")
}

model SharedBillHistory {
  id        String     @id @default(uuid()) @db.Uuid
  billId    String     @db.Uuid
  actorId   String     @db.Uuid
  action    String     @db.VarChar(12)
  snapshot  Json
  createdAt DateTime   @default(now())
  bill      SharedBill @relation(fields: [billId], references: [id], onDelete: Restrict)
  actor     User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([billId, createdAt])
  @@map("shared_bill_history")
}

model GroupSettlement {
  id                  String                   @id @default(uuid()) @db.Uuid
  groupId             String                   @db.Uuid
  creatorId           String                   @db.Uuid
  fromMemberId        String                   @db.Uuid
  toMemberId          String                   @db.Uuid
  amountMinor         BigInt
  currency            String                   @db.VarChar(3)
  minorUnit           Int
  paidOn              DateTime                 @db.Date
  note                String                   @db.VarChar(300)
  status              String                   @default("PENDING") @db.VarChar(20)
  version             Int                      @default(1)
  reversalRequesterId String?                  @db.Uuid
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  group               SplitGroup               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  creator             User                     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  fromMember          SplitMember              @relation("SettlementSender", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember            SplitMember              @relation("SettlementRecipient", fields: [toMemberId], references: [id], onDelete: Restrict)
  reversalRequester   SplitMember?             @relation("ReversalRequester", fields: [reversalRequesterId], references: [id], onDelete: Restrict)
  history             GroupSettlementHistory[]

  @@index([groupId, createdAt])
  @@map("group_settlements")
}

model GroupSettlementHistory {
  id           String          @id @default(uuid()) @db.Uuid
  settlementId String          @db.Uuid
  actorId      String          @db.Uuid
  action       String          @db.VarChar(32)
  snapshot     Json
  createdAt    DateTime        @default(now())
  settlement   GroupSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  actor        User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([settlementId, createdAt])
  @@map("group_settlement_history")
}
