# Local Docker only. Keep existing .env credentials when reusing a database volume.
POSTGRES_DB=paylet
POSTGRES_USER=paylet
# Generate independent random hexadecimal values; do not use these placeholders.
POSTGRES_PASSWORD=replace_with_random_hex_database_password
SESSION_SECRET=replace_with_random_hex_session_secret_at_least_32_characters
# Register http://localhost:8080/api/auth/google/callback on this Web OAuth client.
GOOGLE_CLIENT_ID=local-disabled
GOOGLE_CLIENT_SECRET=local-disabled
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
