APP_DOMAIN=finance.example.com
ACME_EMAIL=you@example.com

# Dedicated managed PostgreSQL 17 database. Use its private hostname and CA.
# URL-encode username/password. Download the provider CA to deploy/certs/ca.crt.
DATABASE_URL=postgresql://paylet_app:CHANGE_ME@private-db.example.com:25060/paylet?sslmode=verify-full&sslrootcert=/run/db-certs/ca.crt
MIGRATION_DATABASE_URL=postgresql://paylet_owner:CHANGE_ME@private-db.example.com:25060/paylet?sslmode=verify-full&sslrootcert=/run/db-certs/ca.crt
SESSION_SECRET=CHANGE_ME_generate_48_random_bytes
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=

# pg_dump uses libpq: omit Prisma's schema URL parameter.
# Prefer a read-only backup account with SELECT access to all tables.
BACKUP_DATABASE_URL=postgresql://paylet_backup:CHANGE_ME@private-db.example.com:25060/paylet?sslmode=verify-full&sslrootcert=/run/db-certs/ca.crt
RESTIC_REPOSITORY=s3:https://REGION.digitaloceanspaces.com/BUCKET/paylet
RESTIC_PASSWORD=CHANGE_ME_store_separately_in_a_password_manager
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Backup heartbeat URL: configure a daily schedule and missed-run alerts.
BACKUP_MONITOR_URL=
# Larger than your database dump plus restore-test database.
BACKUP_TMPFS_SIZE=512m
